# Let's Encrypt settings for the "letsencrypt" service.
# Any lego option can be set here as LEGO_<OPTION>; see `docker run --rm goacme/lego:v5.5.2 run --help`.

# Required: contact address for expiry notices and account recovery.
LEGO_EMAIL=you@example.com

# Names on the certificate. Defaults to XMPP_DOMAIN (plus XMPP_FQDN if different).
# Add conference.<domain> if you federate with other XMPP servers.
#LEGO_DOMAINS=chat.example.com,conference.chat.example.com

# Certificates come from Let's Encrypt's production CA by default. To test without
# hitting its rate limits, uncomment this to use the staging CA instead (clients won't
# trust staging certificates). When switching back to production, also delete the
# openfire_letsencrypt-data volume, or lego keeps the staging certificate until renewal.
#LEGO_SERVER=letsencrypt-staging

# --- Challenge type ---
# Default (LEGO_DNS unset): HTTP-01. Every name above must resolve publicly to this machine,
# and port 80 must reach the letsencrypt container.
#
# DNS-01: works behind NAT/firewalls and needs no open ports. Set LEGO_DNS to your provider's
# code plus that provider's credentials. List providers with:
#   docker run --rm goacme/lego:v5.5.2 dnshelp
# and see a provider's variables with:
#   docker run --rm goacme/lego:v5.5.2 dnshelp -c <code>
#
# Examples:
#LEGO_DNS=cloudflare
#CLOUDFLARE_DNS_API_TOKEN=...
#
#LEGO_DNS=route53
#AWS_ACCESS_KEY_ID=...
#AWS_SECRET_ACCESS_KEY=...
#AWS_REGION=us-east-1
#
# DNS host has no API? Point a _acme-challenge CNAME at an acme-dns server and use LEGO_DNS=acmedns.
