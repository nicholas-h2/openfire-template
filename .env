# Openfire settings, read on FIRST start only. Changing these later has no effect
# unless you wipe the data volume: docker compose down -v

OPENFIRE_IMAGE=ghcr.io/igniterealtime/openfire:v5.1.2

# XMPP domain: user JIDs become <user>@XMPP_DOMAIN
XMPP_DOMAIN=openfire
XMPP_FQDN=openfire

# Admin console (http://localhost:9090), log in as "admin"
OPENFIRE_ADMIN_EMAIL=admin@example.com
OPENFIRE_ADMIN_PASSWORD=admin

# Default user
XMPP_USER=demo
XMPP_USER_PASSWORD=demo
XMPP_USER_NAME=Demo User
XMPP_USER_EMAIL=demo@example.com

# Default chat room: <XMPP_ROOM>@conference.<XMPP_DOMAIN>
XMPP_ROOM=general
XMPP_ROOM_NAME=General
XMPP_ROOM_DESCRIPTION=Default chat room

# Let's Encrypt: uncomment to run the letsencrypt service (configure it in letsencrypt.env).
# XMPP_DOMAIN must then be a real public DNS name.
#COMPOSE_PROFILES=letsencrypt
